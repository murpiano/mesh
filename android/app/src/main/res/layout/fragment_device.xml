<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="2dp">

        <!-- FrameLayout, not weighted LinearLayout: deviceNameText is centered on the true
             midpoint of the row regardless of how wide "Mesh" or the gear icon are (a weight-1
             split either side is only symmetric when both fixed-width neighbors match). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/meshTitle"
                android:background="@drawable/ripple_rounded"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="Mesh"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/deviceNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="22sp"
                android:ellipsize="end"
                android:maxLines="1"/>

            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:text="⚙"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"/>
        </FrameLayout>

        <!-- Back arrow (left) + connection-status word, centered under the device name —
             see DeviceFragment.refreshConnectionState. The arrow matches deviceNameText's
             size/color; the status word keeps its own small size and takes the stripe's color.
             Pressed close against the stripe below (small marginTop, no bottom padding on the
             header). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/backButton"
                android:background="@drawable/ripple_rounded"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="←"
                android:textColor="@color/text_secondary"
                android:textSize="22sp"/>

            <TextView
                android:id="@+id/connectionStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="11sp"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Thin connection-status stripe: the actual current link state to this device, not just
         whether it's paired — see MainActivity.ConnectionStatus / DeviceFragment.refreshStatus. -->
    <View
        android:id="@+id/connectionStatusStripe"
        android:layout_width="match_parent"
        android:layout_height="3dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_header"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/chatSectionTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/tab_selector"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/chatSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="chat"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Only shown when the peer announced that it can take a cast and is connected now —
             see DeviceFragment.refreshCastSection. -->
        <LinearLayout
            android:id="@+id/castSectionTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/tab_selector"
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/castSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="cast"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/explorerSectionTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/tab_selector"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/explorerSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="explorer"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <FrameLayout
        android:id="@+id/deviceChildContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
