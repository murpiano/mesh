<?xml version="1.0" encoding="utf-8"?>
<!-- A device row's 0/1 switch while it is on: the same green as an online status dot, with the tap ripple every other
     tappable thing carries. Twin of the DeviceToggle style in the desktop app's Theme.xaml. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="13dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/status_online"/>
            <corners android:radius="13dp"/>
        </shape>
    </item>
</ripple>
