<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same dark palette as the Android app (android/app/src/main/res/values/colors.xml): both
         apps are one product, so every color here has an Android twin of the same name. -->
    <SolidColorBrush x:Key="BgScreen" Color="#FF18181A"/>
    <SolidColorBrush x:Key="BgHeader" Color="#FF2A2A2C"/>
    <SolidColorBrush x:Key="BgCard" Color="#FF242426"/>
    <SolidColorBrush x:Key="BgBubblePeer" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="BgBubbleSelf" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="BgBubblePeerHover" Color="#FF35353A"/>
    <SolidColorBrush x:Key="BgBubbleSelfHover" Color="#FF44444A"/>
    <SolidColorBrush x:Key="BgSelectedActive" Color="#FFFFCC66"/>
    <!-- What a control looks like under the pointer and while it is being pressed. The phone has
         no pointer, so its twins (colors.xml) are the ripple and the pressed state. -->
    <SolidColorBrush x:Key="BgHover" Color="#FF303034"/>
    <SolidColorBrush x:Key="BgPressed" Color="#FF3E3E44"/>
    <SolidColorBrush x:Key="BgPopup" Color="#FF323234"/>
    <SolidColorBrush x:Key="BgPopupItemPressed" Color="#FF3E3E42"/>
    <SolidColorBrush x:Key="DividerPopup" Color="#FF46464A"/>
    <SolidColorBrush x:Key="BgMdnsError" Color="#FF3A1F1D"/>
    <SolidColorBrush x:Key="DialogScrim" Color="#80000000"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9A9AA0"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FFD0D0D4"/>
    <SolidColorBrush x:Key="Divider" Color="#FF3A3A3C"/>

    <SolidColorBrush x:Key="StatusOnline" Color="#FF34C759"/>
    <SolidColorBrush x:Key="StatusOfflineRing" Color="#FF6C6C70"/>

    <SolidColorBrush x:Key="ActionPositive" Color="#FF34C759"/>
    <SolidColorBrush x:Key="ActionNegative" Color="#FFFF453A"/>

    <SolidColorBrush x:Key="ConnConnected" Color="#FF34C759"/>
    <SolidColorBrush x:Key="ConnDisconnected" Color="#FF8E8E93"/>
    <SolidColorBrush x:Key="ConnUnpaired" Color="#FFFF3B30"/>
    <SolidColorBrush x:Key="ConnOffline" Color="#FF48484A"/>

    <!-- The 0/1 switch in a device row: its grey track when off, and the white knob that carries
         the 0/I mark. Green when on comes from StatusOnline, the same green as an online dot. -->
    <SolidColorBrush x:Key="ToggleTrackOff" Color="#FF48484A"/>
    <SolidColorBrush x:Key="ToggleKnob" Color="#FFFFFFFF"/>

    <!-- A button that is just its content (text or glyph) until you point at it: then it takes a
         rounded tint, and a stronger one while held, so every click has something to answer it.
         The phone's twins are the ripples in drawable/. -->
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- Room for the hover tint to sit around the text rather than against it. -->
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Grows a little under the pointer and sinks under the press, so the
                             two states read at a glance and not only as a change of shade. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgHover}"/>
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgPressed}"/>
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One of the two tabs on a device's page. The active one is marked with Tag="active"
         rather than a background set from code, so pointing at a tab can still tint it — a local
         background would outrank every trigger here. -->
    <Style x:Key="SectionTab" TargetType="Button" BasedOn="{StaticResource TextButton}">
        <Setter Property="Background" Value="{StaticResource BgHeader}"/>
        <Setter Property="Padding" Value="0,14,0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="Chrome" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgPressed}"/>
                        </Trigger>
                        <!-- Last, so the open tab keeps its own colour under the pointer. -->
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgScreen}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A device row: the whole row answers the pointer, and the yellow highlight it wears while
         its menu is open outranks both pointer states. -->
    <Style x:Key="DeviceRowButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="Chrome" Background="{TemplateBinding Background}"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- A row is wide, so it swells far less than a button would. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgHover}"/>
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.02" ScaleY="1.06"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgPressed}"/>
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.995" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgSelectedActive}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The switch between a device's name and its state. Flicked right and green while that
         device is connecting or connected, grey and left otherwise; clicking it is what
         connects, cancels a connection still being made, and disconnects, while a click
         anywhere else on the row still opens the device. It carries no hover or pressed state
         of its own — the row under it already answers the pointer, and a switch that also
         swelled read as two controls. Twin of toggle_track_on.xml / toggle_track_off.xml on the
         phone. -->
    <Style x:Key="DeviceToggle" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- The transparent padding is the point: the switch is small, so clicks
                         land around it as often as on it, and every one of those used to open
                         the device page instead. -->
                    <Border Background="Transparent" Padding="12,10">
                    <Border Name="Track" Width="38" Height="20" CornerRadius="10"
                            Background="{StaticResource ToggleTrackOff}">
                        <Border Name="Knob" Width="16" Height="16" CornerRadius="8" Margin="2,0"
                                HorizontalAlignment="Left" Background="{StaticResource ToggleKnob}">
                            <TextBlock Name="Mark" Text="0" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BgScreen}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSwitchOn}" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource StatusOnline}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Mark" Property="Text" Value="I"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List rows without the system selection/hover highlight: the Android lists have none,
         highlighting is done explicitly (BgSelectedActive) while a row's popup is open. -->
    <Style x:Key="PlainListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainListBox" TargetType="ListBox">
        <!-- ListBox otherwise sets the system (black) text color on its items. -->
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PlainListBoxItem}"/>
    </Style>

    <!-- Thin dark scrollbar: the default light one stands out on the dark screens. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#FF4A4A4E" CornerRadius="3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded dark text field, same shape and color as the Android chat input. -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BgSelectedActive}"/>
        <Setter Property="Background" Value="{StaticResource BgBubblePeer}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- Padding belongs to the content host, not the border: a TextBox indents its
                         own text by its Padding too, so putting it on both left the caret of an
                         empty box a full Padding to the right of the hint text behind it. -->
                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                        <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Center"
                                      Padding="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
