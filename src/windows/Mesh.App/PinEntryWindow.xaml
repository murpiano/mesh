<Window x:Class="Mesh.App.PinEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connecting" SizeToContent="Height" Width="320" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <StackPanel Name="ConnectingPanel">
            <TextBlock Name="ConnectingText" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <Button Name="ConnectingCancelButton" Content="Cancel" MinWidth="100" HorizontalAlignment="Center"
                    Click="ConnectingCancelButton_Click"/>
        </StackPanel>
        <StackPanel Name="EntryPanel" Visibility="Collapsed">
            <TextBlock Name="EntryMessageText" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBox Name="CodeTextBox" FontSize="20" HorizontalContentAlignment="Center" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="SubmitButton" Content="Submit" MinWidth="100" Margin="0,0,8,0"
                        IsDefault="True" Click="SubmitButton_Click"/>
                <Button Name="CancelButton" Content="Cancel" MinWidth="100" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
