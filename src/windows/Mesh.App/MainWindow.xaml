<Window x:Class="Mesh.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesh" Width="420" Height="760" MinWidth="360" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgScreen}"
        Foreground="{StaticResource TextPrimary}"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- One chat message. Only the bubble itself answers the pointer; the rest of the row is
             background, where a click clears whatever is open (as on the phone). -->
        <Style x:Key="ChatBubbleBorderStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Background" Value="{StaticResource BgBubblePeer}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MaxWidth" Value="260"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Background" Value="{StaticResource BgBubbleSelf}"/>
                </DataTrigger>
                <!-- A bubble lifts a shade under the pointer, so it reads as something you can
                     click (it opens the message menu). The highlight below still wins. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgBubblePeerHover}"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOwn}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource BgBubbleSelfHover}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgSelectedActive}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ChatBubbleTemplate">
            <!-- Only the bubble answers clicks; the empty space beside it belongs to the page,
                 where a click dismisses whatever is open (see ChatBackground_Click). -->
            <Grid Background="Transparent" Margin="0,2">
                <Border Style="{StaticResource ChatBubbleBorderStyle}" Cursor="Hand"
                        PreviewMouseLeftButtonUp="ChatBubble_LeftClick"
                        PreviewMouseRightButtonUp="ChatBubble_RightClick">
                    <TextBox Name="BubbleText" Text="{Binding Message.DisplayText, Mode=OneWay}"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                             TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource TextPrimary}"
                             SelectionBrush="{StaticResource BgSelectedActive}" Cursor="Hand"
                             ContextMenuService.IsEnabled="False"/>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="HeaderTitle" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Content" Value="Mesh"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="GearButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Content" Value="&#x2699;"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <!-- Nothing behind it yet: it must not light up as if there were. -->
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Devices page (Android: fragment_devices.xml) -->
        <DockPanel Name="DevicesPage">
            <Border DockPanel.Dock="Top" Background="{StaticResource BgHeader}" Padding="20,16">
                <Grid>
                    <Button Style="{StaticResource HeaderTitle}" HorizontalAlignment="Left"
                            Click="MeshTitle_Click"/>
                    <Button Style="{StaticResource GearButton}" FontSize="22" HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Name="MdnsErrorBanner" Visibility="Collapsed"
                    Background="{StaticResource BgMdnsError}" Padding="10" Margin="16,16,16,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Refresh"
                            Foreground="{StaticResource TextPrimary}" FontSize="14" VerticalAlignment="Center"
                            Margin="8,0,0,0" Click="RefreshButton_Click"/>
                    <TextBlock Text="mDNS unreachable — check firewall settings" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Border Background="{StaticResource BgCard}" CornerRadius="12" Margin="16" Padding="16">
                <!-- Shared size scope: the Status column is exactly as wide as the word "Devices"
                     above it, in the header and in every row (hidden "Devices" sizers below). -->
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Devices" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Status"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Devices" FontSize="17" FontWeight="Bold" Height="0" Visibility="Hidden"/>
                        <TextBlock Text="Status" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Name" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="State" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Grid>
                    <Border Grid.Row="2" Height="1" Background="{StaticResource Divider}" Margin="0,0,0,4"/>
                    <ListBox Grid.Row="3" Name="DeviceListBox" Style="{StaticResource PlainListBox}"
                             AlternationCount="100000">
                        <ListBox.ItemContainerStyle>
                            <!-- A divider between rows, not above the first one. -->
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListBoxItem}">
                                <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
                                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DeviceRowButton}"
                                        Click="DeviceRow_Click" MouseRightButtonUp="DeviceRow_RightClick">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Status"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Devices" FontSize="17" FontWeight="Bold" Height="0" Visibility="Hidden"/>
                                    <Ellipse Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             StrokeThickness="2">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Stroke" Value="{StaticResource StatusOfflineRing}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource StatusOnline}"/>
                                                        <Setter Property="Stroke" Value="{StaticResource StatusOnline}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16" Margin="0,14"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding StateLabel}" FontSize="14"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Device page (Android: fragment_device.xml) -->
        <DockPanel Name="DevicePage" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Background="{StaticResource BgHeader}" Padding="20,16,20,2">
                <StackPanel>
                    <Grid>
                        <Button Style="{StaticResource HeaderTitle}" HorizontalAlignment="Left"
                                Click="MeshTitle_Click"/>
                        <TextBlock Name="DeviceNameText" FontSize="22" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        <Button Style="{StaticResource GearButton}" FontSize="20" HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Button Style="{StaticResource TextButton}" Content="&#x2190;" FontSize="22"
                                Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left"
                                Click="BackButton_Click"/>
                        <TextBlock Name="ConnectionStatusLabel" FontSize="11" HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Name="ConnectionStatusStripe" Height="3"/>
            <Grid DockPanel.Dock="Top" Background="{StaticResource BgHeader}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Name="ChatSectionTab" Grid.Column="0" Style="{StaticResource SectionTab}"
                        Click="ChatSectionTab_Click">
                    <TextBlock Name="ChatSectionLabel" Text="chat" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Button>
                <Button Name="ExplorerSectionTab" Grid.Column="1" Style="{StaticResource SectionTab}"
                        Click="ExplorerSectionTab_Click">
                    <TextBlock Name="ExplorerSectionLabel" Text="explorer" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Button>
            </Grid>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Divider}"/>

            <Grid>
                <!-- Chat section (Android: fragment_chat.xml) -->
                <DockPanel Name="ChatSection" Margin="12">
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Its own rounded background rather than a Border inside, so pointing at
                             it tints the button itself (see TextButton). -->
                        <Button Name="AttachButton" Style="{StaticResource TextButton}" Width="40" Height="40"
                                Padding="0" Background="{StaticResource BgBubblePeer}"
                                VerticalAlignment="Bottom" Click="AttachButton_Click">
                            <TextBlock Text="+" FontSize="20" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <TextBox Name="ChatInputBox" Style="{StaticResource DarkTextBox}" TextWrapping="Wrap"
                                     AcceptsReturn="True" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="ChatInputBox_PreviewKeyDown" TextChanged="ChatInputBox_TextChanged"/>
                            <!-- Left margin matches the input's own Padding, so the hint starts
                                 exactly where typed text does and the caret sits before its T. -->
                            <TextBlock Name="ChatInputHint" Text="Type a message…" FontSize="15" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextSecondary}" Margin="16,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Button Name="SendButton" Grid.Column="2" Style="{StaticResource TextButton}" Content="Send"
                                FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center" Click="SendButton_Click"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Name="NotConnectedHint"
                               Text="Not connected — connect on the Devices tab to send."
                               FontStyle="Italic" FontSize="13" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <!-- Clicking the empty space around the messages clears the open popup and
                         any text selection, the way tapping the background does on the phone. -->
                    <ListBox Name="ChatListBox" Style="{StaticResource PlainListBox}"
                             Background="Transparent"
                             PreviewMouseLeftButtonDown="ChatBackground_Click"
                             ItemTemplate="{StaticResource ChatBubbleTemplate}"/>
                </DockPanel>

                <!-- Explorer section (Android: fragment_explorer.xml) -->
                <TextBlock Name="ExplorerSection" Visibility="Collapsed" Text="Coming soon" FontSize="15"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DockPanel>

        <!-- Short transient notice, the Android Toast: see ShowToast. -->
        <Border Name="Toast" Visibility="Collapsed" IsHitTestVisible="False" Background="#E6323234"
                CornerRadius="16" Padding="16,8" Margin="0,0,0,80"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <TextBlock Name="ToastText" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
        </Border>
        <!-- Overlay for the shared popup menu: no background, so clicks outside the popup card
             still reach the page underneath (see DarkPopup). -->
        <Grid Name="PopupLayer"/>
        <!-- Overlay for modal dialogs (DarkDialog), each with its own dimmed scrim. -->
        <Grid Name="DialogLayer"/>
    </Grid>
</Window>
