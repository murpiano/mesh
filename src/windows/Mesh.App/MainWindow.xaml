<Window x:Class="Mesh.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesh" Height="500" Width="420">
    <Window.Resources>
        <!-- Shared by every dynamically-created device tab's chat ListBox (see BuildDeviceTab).
             Own messages right-aligned/blue, peer messages left-aligned/gray — a normal chat
             layout. The TextBox is read-only by default; MainWindow.xaml.cs flips IsReadOnly to
             let the user edit an own message in place, and relies on the TextBox's native
             selection/Copy for "hold to select text". -->
        <Style x:Key="ChatBubbleBorderStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#FFE5E5EA"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="MaxWidth" Value="280"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Background" Value="#FF3C9CFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChatBubbleTextStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChatSenderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ChatBubbleTemplate">
            <Border Style="{StaticResource ChatBubbleBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Message.SenderLabel}" Style="{StaticResource ChatSenderLabelStyle}"/>
                    <TextBox Text="{Binding Message.DisplayText, Mode=OneWay}" Tag="{Binding}"
                             Style="{StaticResource ChatBubbleTextStyle}"
                             PreviewMouseLeftButtonUp="ChatBubble_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <TabControl Name="MainTabControl">
        <TabItem Header="Devices">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Second, section-strip tab row — see MainWindow.xaml.cs's BuildSectionStrip.
                     Always present (same reserved height) below the top-level tab headers;
                     empty here since the Devices tab has no sub-sections of its own. -->
                <Border Grid.Row="0" Name="DevicesSectionStrip" Height="32" Margin="0,0,0,8"
                        BorderBrush="#FFD3D3D3" BorderThickness="0,0,0,1"/>
                <Border Grid.Row="1" Name="MdnsErrorBanner" Visibility="Collapsed"
                        Background="#FFFDECEA" BorderBrush="#FFE57373" BorderThickness="1"
                        Padding="8" Margin="0,0,0,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Name="RefreshButton" Content="Refresh"
                                Padding="10,2" Click="RefreshButton_Click"/>
                        <TextBlock Text="mDNS unreachable — check firewall settings"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <TextBlock Grid.Row="2" Text="Devices" FontWeight="Bold" Margin="0,0,0,8"/>
                <ListBox Grid.Row="3" Name="DeviceListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6" MouseLeftButtonUp="DeviceRow_Click">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{Binding NameBrush}"
                                           VerticalAlignment="Center" FontSize="14"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Pair" Width="70" Click="PairButton_Click" Tag="{Binding}"
                                            Visibility="{Binding PairVisibility}" IsEnabled="{Binding PairEnabled}"/>
                                    <Button Content="{Binding ConnectLabel}" Width="80" Margin="4,0,0,0"
                                            Background="{Binding ConnectBrush}" IsEnabled="{Binding ConnectEnabled}"
                                            Click="ConnectRow_Click" Tag="{Binding}"
                                            Visibility="{Binding PairedVisibility}"/>
                                    <Button Content="Disconnect" Width="80" Margin="4,0,0,0"
                                            Background="{Binding DisconnectBrush}" IsEnabled="{Binding DisconnectEnabled}"
                                            Click="DisconnectRow_Click" Tag="{Binding}"
                                            Visibility="{Binding PairedVisibility}"/>
                                    <Button Content="&#x2715;" Width="28" Margin="4,0,0,0" Foreground="DarkRed"
                                            IsEnabled="{Binding UnpairEnabled}"
                                            Click="UnpairButton_Click" Tag="{Binding}"
                                            Visibility="{Binding PairedVisibility}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="4" Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="Gray"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
