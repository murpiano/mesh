<Window x:Class="Mesh.App.PinConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm PIN" SizeToContent="Height" Width="320" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Name="PinText" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="MatchButton" Content="Match" MinWidth="100" Margin="0,0,8,0" Click="MatchButton_Click"/>
            <Button Name="NoMatchButton" Content="Not matching" MinWidth="120" Click="NoMatchButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
